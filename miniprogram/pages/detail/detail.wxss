@import "/styles/icons.wxss";

.page { padding-bottom: 20rpx; }

/* ---------- 顶部多图轮播 ---------- */
.gallery { position: relative; background: #111; }
.sw { width: 100%; height: 640rpx; }
.sw-img { width: 100%; height: 640rpx; display: block; }
.sw-ph {
  width: 100%; height: 560rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: radial-gradient(120% 90% at 50% 25%, #1c1913 0%, #0d0d0d 68%);
}
.sw-ph-ring {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 1rpx solid rgba(212,160,23,0.3);
  color: rgba(212,160,23,0.6); font-size: 36rpx; letter-spacing: 4rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 26rpx;
}
.sw-ph-txt { font-size: 23rpx; color: #55504a; letter-spacing: 3rpx; }
.zoom-tip {
  position: absolute; right: 24rpx; bottom: 24rpx;
  font-size: 19rpx; color: rgba(255,255,255,0.45);
  background: rgba(0,0,0,0.42);
  padding: 6rpx 18rpx; border-radius: 24rpx;
  letter-spacing: 1rpx;
}

/* ---------- 卡片 ---------- */
.card { margin: 20rpx 24rpx 0; }
.pad { padding: 30rpx 28rpx; }

.name {
  font-size: 36rpx; font-weight: 700; color: #f5f1e9;
  line-height: 1.45; letter-spacing: 1rpx;
}
.tags { margin-top: 16rpx; }
.tg { font-size: 22rpx; color: #a8862c; line-height: 1.6; margin-right: 10rpx; word-break: break-all; }
.meta {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-top: 22rpx; padding-top: 22rpx;
  border-top: 1rpx solid rgba(255,255,255,0.06);
}
.price { font-size: 44rpx; font-weight: 700; color: #d4a017; letter-spacing: 1rpx; }
.sales { font-size: 22rpx; color: #7d776e; }

.ct { display: flex; align-items: center; font-size: 27rpx; font-weight: 600; color: #ece7de; letter-spacing: 2rpx; }
.ct-bar { width: 4rpx; height: 26rpx; background: #d4a017; border-radius: 2rpx; margin-right: 14rpx; }
.desc { margin-top: 18rpx; font-size: 27rpx; color: #a8a29a; line-height: 1.85; white-space: pre-wrap; }
.empty-txt { color: #55504a; }
.cat-chip {
  display: inline-block; margin-top: 18rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(212,160,23,0.3);
  background: rgba(212,160,23,0.05);
  border-radius: 30rpx; font-size: 25rpx; color: #c9a13a;
}

/* ---------- 卡片内联系方式 ---------- */
.c-row { display: flex; align-items: center; margin-top: 18rpx; }
.c-ic { width: 30rpx; height: 30rpx; margin-right: 18rpx; flex-shrink: 0; }
.c-v { font-size: 26rpx; color: #b8b2a8; flex: 1; }

/* ---------- 底部固定操作栏 ---------- */
.spacer { height: 170rpx; }
.bbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center;
  background: rgba(13,13,13,0.97);
  border-top: 1rpx solid rgba(255,255,255,0.07);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.b-item {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  margin-right: 40rpx; flex-shrink: 0;
}
.b-ic { width: 40rpx; height: 40rpx; margin-bottom: 6rpx; }
.b-txt { font-size: 20rpx; color: #8b857c; letter-spacing: 1rpx; }
.b-share {
  flex: 1; margin: 0; padding: 0; height: 88rpx; line-height: 88rpx;
  background: linear-gradient(135deg, #d9ab2c 0%, #c2900f 55%, #a87a0c 100%);
  color: #17130a; font-size: 29rpx; font-weight: 700; letter-spacing: 3rpx;
  border-radius: 44rpx; text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(212,160,23,0.18);
}
.b-share::after { border: none; }
