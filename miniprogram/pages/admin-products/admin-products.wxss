.page { padding: 24rpx 24rpx 60rpx; }

.sbar { margin-bottom: 22rpx; }
.sbox {
  display: flex; align-items: center; height: 80rpx; padding: 0 24rpx;
  background: #141414; border: 1rpx solid #262626; border-radius: 40rpx;
}
.sbox .mag { flex-shrink: 0; margin-right: 18rpx; }
.sinput { flex: 1; min-width: 0; font-size: 27rpx; color: #ece7de; }
.sclear {
  width: 40rpx; height: 40rpx; border-radius: 50%; background: #2a2a2a;
  color: #9a948a; font-size: 28rpx; line-height: 36rpx; text-align: center; flex-shrink: 0;
}

.bar { margin-bottom: 24rpx; }
.bar-tip { font-size: 22rpx; color: #7d776e; letter-spacing: 1rpx; margin-bottom: 18rpx; }
.add-btn { padding: 22rpx 0; }

.item {
  background: #141414; border: 1rpx solid #232323;
  border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx;
}
.top { display: flex; align-items: flex-start; }
.thumb { width: 150rpx; height: 150rpx; border-radius: 12rpx; background: #1c1c1c; flex-shrink: 0; }
.thumb-ph { display: flex; align-items: center; justify-content: center; }
.thumb-txt { font-size: 21rpx; color: #55504a; letter-spacing: 1rpx; }

.info { flex: 1; min-width: 0; margin-left: 22rpx; }
.name {
  font-size: 28rpx; font-weight: 600; color: #ece7de; line-height: 1.45;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.sub { font-size: 22rpx; color: #7d776e; margin-top: 10rpx; }
.sub .price { color: #b8912f; font-weight: 600; }
.dot { margin: 0 8rpx; color: #3d3a35; }
.badge {
  display: inline-block; margin-top: 12rpx;
  font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 6rpx;
}
.badge.on { color: #8fa86a; background: rgba(143,168,106,0.1); }
.badge.off { color: #a0685f; background: rgba(160,104,95,0.1); }

.ops {
  display: flex; flex-wrap: wrap;
  margin-top: 22rpx; padding-top: 22rpx;
  border-top: 1rpx solid rgba(255,255,255,0.05);
}
.op {
  padding: 12rpx 30rpx; margin: 0 14rpx 12rpx 0;
  border: 1rpx solid #2e2e2e; border-radius: 10rpx;
  font-size: 23rpx; color: #b8b2a8;
}
.op.danger { color: #c06060; border-color: #4a2626; }
