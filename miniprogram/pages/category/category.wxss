.page { display: flex; height: 100vh; background: #0a0a0a; }

/* ---------- 左侧分类栏 ---------- */
.side {
  width: 186rpx; flex-shrink: 0;
  background: #0d0d0d;
  border-right: 1rpx solid #1e1e1e;
  display: flex; flex-direction: column;
}
.side-top { height: 104rpx; display: flex; align-items: center; padding-left: 30rpx; }
.side-search { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.side-scroll { flex: 1; }
.side-item {
  position: relative;
  padding: 30rpx 16rpx 30rpx 24rpx;
  display: flex; align-items: center;
  background: #0d0d0d;
}
.side-bar {
  position: absolute; left: 0; top: 50%; margin-top: -22rpx;
  width: 4rpx; height: 44rpx; border-radius: 2rpx;
  background: transparent;
}
.side-txt { font-size: 25rpx; color: #7d776e; line-height: 1.42; letter-spacing: 1rpx; }
.side-item.active { background: #0a0a0a; }
.side-item.active .side-bar { background: #d4a017; }
.side-item.active .side-txt { color: #d4a017; font-weight: 600; }
.side-pad { height: 120rpx; }

/* ---------- 右侧主区 ---------- */
.main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.sort-bar {
  position: relative;
  display: flex; align-items: center;
  height: 104rpx; padding: 0 6rpx 0 16rpx;
  background: #0a0a0a;
}
.sort-item {
  padding: 0 20rpx; font-size: 25rpx; color: #6b665f; letter-spacing: 1rpx;
  height: 104rpx; display: flex; align-items: center;
}
.sort-item.on { color: #d4a017; font-weight: 600; }
.sort-line {
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 1rpx; background: rgba(255,255,255,0.06);
}

.list { flex: 1; }

/* ---------- 双列网格 ---------- */
.grid { display: flex; flex-wrap: wrap; padding: 10rpx 8rpx 0; }
.g-card { width: 50%; padding: 8rpx; }
.g-img {
  width: 100%; height: 262rpx; display: block;
  border-radius: 12rpx 12rpx 0 0; background: #161616;
}
.g-ph {
  display: flex; align-items: center; justify-content: center; background: #161616;
}
.g-ph-txt { font-size: 21rpx; color: #4e4a44; letter-spacing: 2rpx; }
.g-body {
  background: #141414;
  border: 1rpx solid #232323; border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  padding: 14rpx 16rpx 18rpx;
}
.g-name {
  font-size: 25rpx; font-weight: 600; color: #ece7de; line-height: 1.42;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; min-height: 72rpx;
}
.g-tags { margin-top: 8rpx; }
.g-tg { font-size: 20rpx; color: #a8862c; line-height: 1.5; margin-right: 6rpx; word-break: break-all; }
.g-meta {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-top: 10rpx; padding-top: 10rpx;
  border-top: 1rpx solid rgba(255,255,255,0.05);
}
.g-price { font-size: 27rpx; font-weight: 700; color: #d4a017; }
.g-sales { font-size: 19rpx; color: #6b665f; }

.list-pad { height: 160rpx; }

/* ---------- 悬浮管理按钮 ---------- */
.fab {
  position: fixed; right: 32rpx; bottom: 48rpx;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(140deg, #d9ab2c 0%, #c2900f 55%, #a87a0c 100%);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 26rpx rgba(212,160,23,0.3);
  z-index: 20;
}
.fab-txt { font-size: 26rpx; font-weight: 700; color: #17130a; letter-spacing: 2rpx; }
