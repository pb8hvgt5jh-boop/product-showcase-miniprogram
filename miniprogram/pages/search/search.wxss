.page { padding-bottom: 20rpx; }

/* ---------- 搜索框 ---------- */
.sbar {
  display: flex; align-items: center;
  padding: 24rpx 24rpx 20rpx;
  background: #0a0a0a;
}
.sbox {
  flex: 1; min-width: 0;
  display: flex; align-items: center;
  height: 80rpx; padding: 0 24rpx;
  background: #161616;
  border: 1rpx solid #262626;
  border-radius: 40rpx;
}
.sbox .mag { flex-shrink: 0; margin-right: 18rpx; }
.sinput { flex: 1; min-width: 0; font-size: 27rpx; color: #ece7de; }
.sclear {
  width: 40rpx; height: 40rpx; margin-left: 10rpx;
  border-radius: 50%; background: #2a2a2a; color: #9a948a;
  font-size: 28rpx; line-height: 36rpx; text-align: center; flex-shrink: 0;
}
.sgo {
  margin-left: 20rpx; flex-shrink: 0;
  padding: 0 34rpx; height: 80rpx; line-height: 80rpx;
  border-radius: 40rpx; font-size: 27rpx; font-weight: 600; letter-spacing: 2rpx;
  color: #d4a017;
  border: 1rpx solid rgba(212,160,23,0.34);
  background: rgba(212,160,23,0.05);
}

/* ---------- 历史 / 热门 ---------- */
.blk { padding: 30rpx 24rpx 0; }
.blk-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.blk-title { font-size: 26rpx; color: #b8b2a8; letter-spacing: 2rpx; }
.blk-clear { font-size: 24rpx; color: #7d776e; }
.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 14rpx 30rpx; margin: 0 16rpx 16rpx 0;
  background: #141414; border: 1rpx solid #262626;
  border-radius: 34rpx; font-size: 25rpx; color: #b8b2a8;
}
.chip.hot { color: #c9a13a; border-color: rgba(212,160,23,0.26); background: rgba(212,160,23,0.05); }

/* ---------- 排序栏 ---------- */
.sort-bar {
  display: flex; align-items: center;
  padding: 22rpx 24rpx 16rpx;
}
.sort-item {
  font-size: 25rpx; color: #6b665f; letter-spacing: 1rpx;
  margin-right: 44rpx; padding-bottom: 8rpx;
  border-bottom: 2rpx solid transparent;
}
.sort-item.on { color: #d4a017; font-weight: 600; border-bottom-color: rgba(212,160,23,0.7); }
.sort-count { margin-left: auto; font-size: 21rpx; color: #55504a; }
