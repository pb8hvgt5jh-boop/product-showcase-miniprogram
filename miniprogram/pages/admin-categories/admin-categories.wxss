@import "/styles/icons.wxss";

.page { padding: 24rpx 24rpx 60rpx; }

.bar { margin-bottom: 24rpx; }
.bar-tip { font-size: 22rpx; color: #7d776e; letter-spacing: 1rpx; margin-bottom: 18rpx; }
.add-btn { padding: 22rpx 0; }

.item {
  background: #141414; border: 1rpx solid #232323;
  border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx;
}
.top { display: flex; align-items: center; }

.thumb-wrap { flex-shrink: 0; }
.thumb {
  width: 160rpx; height: 110rpx; display: block;
  border-radius: 12rpx; background: #1c1c1c;
}
.thumb-ph {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 1rpx dashed #333;
}
.thumb-ph .ic { width: 34rpx; height: 34rpx; opacity: .7; }
.thumb-txt { font-size: 19rpx; color: #7d776e; margin-top: 8rpx; letter-spacing: 1rpx; }

.info { flex: 1; min-width: 0; margin-left: 22rpx; }
.name { font-size: 30rpx; font-weight: 600; color: #ece7de; letter-spacing: 2rpx; }
.sub { font-size: 22rpx; color: #7d776e; margin-top: 10rpx; }
.dot { margin: 0 10rpx; color: #3d3a35; }
.s-on { color: #8fa86a; }
.s-off { color: #a0685f; }

.move { display: flex; flex-direction: column; flex-shrink: 0; }
.mv {
  width: 56rpx; height: 52rpx; margin: 4rpx 0;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid #2e2e2e; border-radius: 10rpx;
  color: #b8b2a8; font-size: 26rpx;
}
.mv.dis { color: #3d3a35; border-color: #222; }

.ops {
  display: flex; flex-wrap: wrap;
  margin-top: 22rpx; padding-top: 22rpx;
  border-top: 1rpx solid rgba(255,255,255,0.05);
}
.op {
  padding: 12rpx 26rpx; margin: 0 14rpx 12rpx 0;
  border: 1rpx solid #2e2e2e; border-radius: 10rpx;
  font-size: 23rpx; color: #b8b2a8;
}
.op.danger { color: #c06060; border-color: #4a2626; }

.foot-tip { font-size: 21rpx; color: #55504a; text-align: center; padding: 20rpx 30rpx; line-height: 1.8; }
